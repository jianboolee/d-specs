# ============================================================
# d-specs 部署环境变量模板
#
#   cp .env.example .env
#   至少填入 POSTGRES_PASSWORD 和 JWT_SECRET，然后 docker compose up -d
#
# 该文件会被 docker compose 自动读取，不要提交真实密钥。
# ============================================================

# ---------- 必填 ----------

# 数据库密码。仅含字母数字最省事；含 @ : / ? # 需 URL 编码
POSTGRES_PASSWORD=

# JWT 签名密钥，生成方式：
#   openssl rand -base64 48 | tr -d '/+='
JWT_SECRET=

# ---------- 可选 ----------

# 镜像与版本。发布新版本后把 tag 改成对应版本号（如 v1.0.0）
# DOCKER_IMAGE=jianboo/d-specs
# DOCKER_TAG=latest

# 应用对外端口（宿主机）。默认 8080
# APP_PORT=8080

# ---------- 数据库 ----------
# 首次启动时由 postgres 镜像初始化，之后改动不再生效
# POSTGRES_USER=dspecs
# POSTGRES_DB=dspecs

# ---------- AI ----------
# 留空则应用可启动，但对话功能不可用
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- 其他 ----------
# JWT 有效期，默认 720h（30 天）
# JWT_EXPIRE=720h
# 容器启动时自动迁移；改为 false 则由发布流程单独执行
# RUN_MIGRATIONS=true
# 时区
# TZ=Asia/Shanghai
# 对外 URL 前缀，与前端同域时留空
# PUBLIC_URL_BASE=
