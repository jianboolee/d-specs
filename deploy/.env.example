# ============================================================
# d-specs —— Portainer 部署变量
# ============================================================

# ---------- 镜像 ----------
DOCKER_IMAGE=jianboo/d-specs
DOCKER_TAG=latest
DOCKER_PLATFORM=linux/amd64

# 应用对外端口（宿主机）
APP_PORT=8400

# ---------- 数据库（必填）----------
#
# ★★★ 部署前请确认这一行 ★★★
# 指向现有 PostgreSQL 实例，库名为 dspecs。
# 若 dspecs 库尚未创建，保持下面 AUTO_CREATE_DB=true 即可自动建库；
# 也可在该实例上手动执行：CREATE DATABASE dspecs;
#
# 下面用的是团队共享实例
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/dspecs?sslmode=disable
#
#
# 若数据库是同宿主机的容器，用 host.docker.internal（stack 已配 extra_hosts）：
#   DATABASE_URL=postgresql://postgres:<password>@host.docker.internal:5432/dspecs?sslmode=disable
#
# 注意：密码含 @ : / ? # 等字符时必须 URL 编码。

# ---------- d-auth 账户中心（必填，跨子域 SSO）----------
# 本地 users 表已移除，d-auth 是唯一的登录通道与身份来源。登录态由 d-auth 下发的
# 共享 cookie 承载（dauth_access = RS256 access JWT），本后端本地验签即认人，
# 不再自签 JWT（无需 JWT_SECRET）。
#
# 缺 DAUTH_BASE_URL / DAUTH_CLIENT_KEY 时应用拒绝启动。
#
# ⚠️ 部署域名必须落在 x-rv.com 下（如 specs.x-rv.com），否则收不到 d-auth 的
#    Domain=.x-rv.com 共享 cookie，SSO 无法生效。
#
# DAUTH_API_KEY 向 d-auth 管理员索取（sk-...，scope 需含 users:read），
# 只用于按 ID 取脱敏展示资料（昵称/头像），留空则展示降级，不影响登录。
#
# 启用前需管理员确认（见 docs/dauth-integration.md）：
#   1. 登记子系统 client（DAUTH_CLIENT_KEY，如 web_specs）；
#   2. DAUTH_ALLOWED_RETURN_ORIGINS 加入本站 origin（https://specs.x-rv.com）；
#   3. 创建一枚 users:read 的 API Key 填入 DAUTH_API_KEY。
DAUTH_BASE_URL=https://auth.x-rv.com
DAUTH_CLIENT_KEY=web_specs
DAUTH_COOKIE_NAME=__Secure-dauth_access
DAUTH_API_KEY=

# ---------- AI ----------
# 留空则应用正常启动，仅 AI 对话不可用
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=120s

# ---------- AI 编排 ----------
AI_MAX_TOOL_ROUNDS=6
AI_AUTO_APPLY_MAX_OPS=30
AI_MAX_TOKENS=32768
AI_TEMPERATURE=0.2

# ---------- 其他 ----------
# 容器启动时自动执行迁移；首次部署保持 true。
# 若数据库尚未建表，保持 true 可由应用自动建表。
RUN_MIGRATIONS=true

# 首次部署：目标库 dspecs 尚未创建时保持 true，会自动执行 CREATE DATABASE dspecs。
# 报错 `database "dspecs" does not exist (SQLSTATE 3D000)` 就是这种情况。
# 库建好并确认数据正常后，建议改回 false（避免库名写错时静默建出空库）。
AUTO_CREATE_DB=true

TZ=Asia/Shanghai
