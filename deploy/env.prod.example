# ============================================================
# d-specs 生产环境变量 —— 填好后放到业务机（47.95.176.70）：
#   /opt/d-specs/.env.prod        （chmod 600；不进 git、不进镜像）
# 改完重启容器生效：TAG=<镜像tag> bash /opt/d-specs/run-prod.sh
#
# 注意：docker --env-file 不识别行尾注释，值必须独占一行、# 注释只能另起一行。
# ============================================================

# ---- 部署 ----
REGISTRY=registry.cn-beijing.aliyuncs.com/xrv/d-specs
TAG=latest
# 应用容器对外端口（绑所有网卡）；入口机经内网 172.17.255.64:8400 反代
APP_PORT=8400

# ---- 数据库（外部实例，入口机的 postgres18:5432）----
# 容器启动时自动执行迁移（RUN_MIGRATIONS=true）。
# 库不存在时先由 AUTO_CREATE_DB=true 建库；建好后改回 false。
# 建议用专用库 + 专用角色（只授权本库），不要用 postgres 超级用户。
DATABASE_URL=postgres://<user>:<password>@172.17.255.63:5432/dspecs?sslmode=disable

# ---- d-auth 账户中心（跨子域 SSO，详见 docs/dauth-integration.md）----
# 登录/登出都由浏览器直连 d-auth：未登录时前端整页跳转 auth.x-rv.com 登录，
# 登录成功后 d-auth 下发 dauth_access / dauth_refresh 两枚 `.x-rv.com` cookie 并回跳；
# d-specs 后端只本地验签 dauth_access，不转发 cookie、不查库、不吊销会话。
# ⚠️ 部署域名必须落在 x-rv.com 下（specs.x-rv.com），否则收不到共享 cookie。
DAUTH_BASE_URL=https://auth.x-rv.com
# 浏览器端登录跳转/登出用的 d-auth origin（可与 DAUTH_BASE_URL 相同）
DAUTH_SSO_BASE_URL=https://auth.x-rv.com
# 子系统应用标识：拼进登录跳转 client=。已在 d-auth 后台登记为 web_specs。
DAUTH_CLIENT_KEY=web_specs
# d-auth 承载 access JWT 的 cookie 名。生产用 __Secure- 前缀（允许设 Domain；__Host- 不允许）。
# 必须与 d-auth 的 DAUTH_COOKIE_NAME 一致，且 d-auth 配 DAUTH_COOKIE_DOMAIN=.x-rv.com。
DAUTH_COOKIE_NAME=__Secure-dauth_access
# 按用户 ID 取展示资料（昵称/头像）的 API Key（sk-...，scope 含 users:read）。
# 在 d-auth 后台创建。未配置时昵称/头像展示降级为空，不影响登录与授权。
DAUTH_API_KEY=sk-...
# 校验 d-auth access token 的 iss。留空自动取 DAUTH_BASE_URL。
# 只是字符串比对，不是密钥 —— RS256 验签的公钥走公开 JWKS 拉取。
DAUTH_JWT_ISSUER=https://auth.x-rv.com
# d-auth 侧需要的配合项（找 d-auth 管理员/运维确认，d-specs 改不了）：
#   ① d-auth 配 DAUTH_COOKIE_DOMAIN=.x-rv.com（生产已配），使 dauth_access 对 specs.x-rv.com 可见。
#   ② d-auth 的 DAUTH_ALLOWED_RETURN_ORIGINS 需包含 https://specs.x-rv.com，
#      否则登录成功后不会自动跳回本站（当前生产只登记了 note.x-rv.com —— 待补）。
#   ③ d-auth 的 DAUTH_ALLOWED_ORIGINS 需包含 https://specs.x-rv.com（生产已配）。
#   ④ DAUTH_CLIENT_KEY=web_specs 已登记。
#   ⑤ DAUTH_JWT_ALG=RS256（生产已配），否则其 JWKS 返回空 keys、验签一律 503。
#   ⑥ 短信验证码限流：登录已由浏览器直连 d-auth，d-auth 直接看到真实设备 IP，
#      不再需要把 d-specs 后端出口 IP 加进 DAUTH_TRUSTED_PROXIES。

# ---- AI（DeepSeek）----
# 留空则应用正常启动，仅 AI 对话不可用
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=120s

# ---- AI 编排 ----
AI_MAX_TOOL_ROUNDS=6
AI_AUTO_APPLY_MAX_OPS=30
AI_MAX_TOKENS=32768
AI_TEMPERATURE=0.2

# ---- 分享页 SEO ----
# 站点规范地址：canonical / OG / sitemap 的绝对地址，生产填对外域名
SITE_URL=https://specs.x-rv.com
SITE_NAME=参数配置表

# ---- 运行 ----
# 容器启动时自动执行迁移；首次部署保持 true。
RUN_MIGRATIONS=true
# 首次部署且目标库尚未创建时设为 true，会自动 CREATE DATABASE。
# 建好之后改回 false（默认），避免库名写错时静默建出空库。
AUTO_CREATE_DB=false
# CORS 放行来源（逗号分隔）。同源部署（前端与 API 同域名）留空即可。
ALLOWED_ORIGINS=
TZ=Asia/Shanghai