# @name share
# @description 分享：开启 / 公开读取 / SSR 页面 / 关闭
#
# 公开地址用表 id（/s/<tableId>），便于被搜索引擎收录；历史 /s/<token> 会
# 301 到规范地址，token 也仍可走 API 兜底解析。
#
# 注意 httpYac 的坑详见 test/README.md。

### 建表用于分享测试
# @name createTable
POST {{baseUrl}}/api/v1/tables
Authorization: Bearer {{token}}
Content-Type: application/json

{ "title": "分享测试表", "description": "用于验证分享与 SEO" }

?? status == 201

{{
  exports.shareTableId = response.parsedBody.data.table.id;
}}

### 写入一条参数
POST {{baseUrl}}/api/v1/tables/{{shareTableId}}/apply
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "base_revision": 0,
  "ops": [
    { "op": "add_item", "item": { "name": "电池容量", "value": "5000mAh", "value_type": "number", "group_name": "续航" } }
  ]
}

?? status == 200

### 分享状态：未开启时应返回 200 + enabled=false，而不是 404
GET {{baseUrl}}/api/v1/tables/{{shareTableId}}/share
Authorization: Bearer {{token}}

?? status == 200
?? js response.parsedBody.data.enabled == false

### 开启分享
# @name enableShare
POST {{baseUrl}}/api/v1/tables/{{shareTableId}}/share
Authorization: Bearer {{token}}

?? status == 200
?? js response.parsedBody.data.enabled == true
?? js response.parsedBody.data.url != undefined

{{
  exports.shareToken = response.parsedBody.data.token;
}}

### 公开地址应是 /s/<表id>，而不是 token
GET {{baseUrl}}/api/v1/tables/{{shareTableId}}/share
Authorization: Bearer {{token}}

?? status == 200
?? js response.parsedBody.data.url == /s/{{shareTableId}}

### 表的可见性应变为 link
GET {{baseUrl}}/api/v1/tables/{{shareTableId}}
Authorization: Bearer {{token}}

?? status == 200
?? body data.table.visibility == link

### 公开读取：按表 id，无需任何鉴权
GET {{baseUrl}}/api/v1/public/specs/{{shareTableId}}

?? status == 200
?? js response.parsedBody.data.title == 分享测试表
?? js response.parsedBody.data.groups.length == 1
?? js response.parsedBody.data.groups[0].items.length == 1
?? js response.parsedBody.data.groups[0].items[0].name == 电池容量
?? js response.parsedBody.data.groups[0].items[0].value == 5000mAh

### 历史 token 仍可兜底解析（兼容已发出的旧链接）
GET {{baseUrl}}/api/v1/public/specs/{{shareToken}}

?? status == 200
?? js response.parsedBody.data.title == 分享测试表

### 公开响应不应暴露参数项 id
GET {{baseUrl}}/api/v1/public/specs/{{shareTableId}}

?? status == 200
?? js response.parsedBody.data.id == undefined
?? js response.parsedBody.data.groups[0].items[0].id == undefined

### 无效 key —— 应 404
GET {{baseUrl}}/api/v1/public/specs/definitely-not-a-real-key

?? status == 404

### 分享页 SSR：不执行 JS 也应能从 HTML 读到标题与正文
GET {{baseUrl}}/s/{{shareTableId}}

?? status == 200
?? body contains 分享测试表
?? body contains 电池容量
?? body contains 5000mAh
?? body contains rel="canonical"
?? body contains application/ld+json

### 分享页不应带 noindex（要允许收录）
GET {{baseUrl}}/s/{{shareTableId}}

?? status == 200
?? body !contains noindex

### 历史 /s/<token> 应 301 到 /s/<表id>
GET {{baseUrl}}/s/{{shareToken}}

?? status == 301
?? header location == /s/{{shareTableId}}

### sitemap.xml 应列出已公开的表
GET {{baseUrl}}/sitemap.xml

?? status == 200
?? body contains /s/{{shareTableId}}

### robots.txt 放行分享页
GET {{baseUrl}}/robots.txt

?? status == 200
?? body contains Allow: /s/

### 再次开启分享应复用同一个 token
POST {{baseUrl}}/api/v1/tables/{{shareTableId}}/share
Authorization: Bearer {{token}}

?? status == 200
?? js response.parsedBody.data.token == {{shareToken}}

### 关闭分享
DELETE {{baseUrl}}/api/v1/tables/{{shareTableId}}/share
Authorization: Bearer {{token}}

?? status == 200
?? js response.parsedBody.data.enabled == false

### 关闭后公开接口立即失效
GET {{baseUrl}}/api/v1/public/specs/{{shareTableId}}

?? status == 404

### 关闭后分享页应 404（便于从搜索索引中摘除）
GET {{baseUrl}}/s/{{shareTableId}}

?? status == 404
?? body contains noindex

### 可见性回到 private
GET {{baseUrl}}/api/v1/tables/{{shareTableId}}
Authorization: Bearer {{token}}

?? status == 200
?? body data.table.visibility == private

### 重新开启：老链接应复活且 token 不变
POST {{baseUrl}}/api/v1/tables/{{shareTableId}}/share
Authorization: Bearer {{token}}

?? status == 200
?? js response.parsedBody.data.token == {{shareToken}}

### 清理
DELETE {{baseUrl}}/api/v1/tables/{{shareTableId}}
Authorization: Bearer {{token}}

?? status == 200
