APP_ENV=development
HTTP_PORT=8401

# 对外 URL 前缀。通过 Nginx 暴露为 /api 时可设置为 /api
PUBLIC_URL_BASE=

# ==================== 分享页 SEO ====================
# 站点名，用于分享页标题后缀、OG site_name 与 JSON-LD
SITE_NAME=参数配置表
# 站点规范地址。留空则按请求的 X-Forwarded-Proto / Host 推导；
# 生产建议显式配置，让 canonical / OG 稳定且不受伪造请求头影响
SITE_URL=
# 分享页 SSR 读取哪个目录的 index.html 来注入 meta 与正文。
#
# 本地开发配 npm run dev（带 HMR、走 Vite 代理）时用 ../web：
#   index.html 引用的是 /src/main.ts，由 Vite 提供，页面能正常跑起来。
# 想验证「构建产物 + 后端」这条生产链路时用 ../web/dist（需先 npm run build，
# 并让容器/静态服务托管 dist，否则 /assets 会 404）。
# 容器内固定为 /usr/share/nginx/html（见 Dockerfile），无需在此配置。
WEB_DIST_DIR=../web

# ==================== PostgreSQL ====================
# 与 ~/Sites/docker/postgres18 共享实例，每个项目一个库
# 格式: postgresql://user:password@host:port/dbname?sslmode=disable
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dspecs?sslmode=disable

# 首次部署到「实例存在但库还没建」的 PostgreSQL 时设为 true，
# 运行迁移前会自动 CREATE DATABASE（需该账号有建库权限）。
# 建好之后建议改回 false：默认关闭可避免库名写错时静默建出空库。
AUTO_CREATE_DB=false

# ==================== d-auth 账户中心（跨子域 SSO）====================
# 用户身份的唯一来源（本地 users 表已移除）。登录态由 d-auth 下发的共享 cookie
# 承载（dauth_access = RS256 access JWT），本后端本地验签即认人，不查库、不请求
# d-auth。登录方式（短信/密码/微信）全部在 d-auth 中央登录页完成。
#
# 生产环境缺 DAUTH_BASE_URL / DAUTH_CLIENT_KEY 会拒绝启动；开发环境缺配置可启动，
# 但登录不可用（本地验签恒失败），方便离线开发公开页。
#
# ⚠️ 部署域名必须落在 x-rv.com 下（如 specs.x-rv.com），否则收不到 d-auth 的
#    Domain=.x-rv.com 共享 cookie，SSO 无法生效。
DAUTH_BASE_URL=
# 浏览器登录跳转/登出用的 d-auth origin；留空回落 DAUTH_BASE_URL（生产两者同域）
DAUTH_SSO_BASE_URL=
# 子系统应用标识：拼进登录跳转的 client= 参数，需在 d-auth 后台登记（如 web_specs）
DAUTH_CLIENT_KEY=
# 承载 access JWT 的 cookie 名，须与 d-auth 的 DAUTH_COOKIE_NAME 一致；
# 生产用 __Secure- 前缀（配 DAUTH_COOKIE_DOMAIN=.x-rv.com 后对全域可见）
DAUTH_COOKIE_NAME=dauth_access
# 校验 access token 的 iss，留空回落 DAUTH_BASE_URL（只是比对字符串，不是密钥）
DAUTH_JWT_ISSUER=
# sk-... 密钥（scope 含 users:read），只用于按 ID 取脱敏展示资料（昵称/头像/掩码手机号）；
# 留空则展示降级为空，不影响登录。只存后端，绝不下发前端。
DAUTH_API_KEY=

# CORS 放行来源（逗号分隔的 origin）。生产同源部署可留空；
# 留空时仅开发环境回显请求来源（本地多端口联调）。
ALLOWED_ORIGINS=

# ==================== DeepSeek ====================
# 首版只接 Flash 档位。模型 id 请以 GET /models 返回的列表为准，
# 运行 `make ai-check` 会拉取列表并核对。实测该账号可用：deepseek-flash、deepseek-v4-pro
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=120s

# ==================== AI 编排 ====================
# agent loop 的最大工具调用轮数，同时也是校验失败后回灌模型自我修正的次数上限
AI_MAX_TOOL_ROUNDS=6
# 安全阀：单次 ops 超过该条数时不自动应用，转为待用户确认。设为 0 表示关闭
AI_AUTO_APPLY_MAX_OPS=30
# deepseek-flash 是推理模型，思考与正文**共享**这个预算。
# 调得太小会出现「思考把预算吃光、正文为空」，一次 add_items 建 30 项约需 8000。
# 8192 在思考较多的轮次仍会被吃光，因此默认给到 32768；该模型允许的最大输出更大，
# 但预算越高极端情况下单次回复越慢，按需调整即可。
AI_MAX_TOKENS=32768
AI_TEMPERATURE=0.2
