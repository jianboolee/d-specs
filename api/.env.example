APP_ENV=development
HTTP_PORT=8300

# 对外 URL 前缀。通过 Nginx 暴露为 /api 时可设置为 /api
PUBLIC_URL_BASE=

# ==================== PostgreSQL ====================
# 与 ~/Sites/docker/postgres18 共享实例，每个项目一个库
# 格式: postgresql://user:password@host:port/dbname?sslmode=disable
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dspecs?sslmode=disable

# 首次部署到「实例存在但库还没建」的 PostgreSQL 时设为 true，
# 运行迁移前会自动 CREATE DATABASE（需该账号有建库权限）。
# 建好之后建议改回 false：默认关闭可避免库名写错时静默建出空库。
AUTO_CREATE_DB=false

# ==================== JWT ====================
# 生成方式: openssl rand -base64 48 | tr -d '/+='
JWT_SECRET=
JWT_EXPIRE=720h

# ==================== DeepSeek ====================
# 首版只接 Flash 档位。模型 id 请以 GET /models 返回的列表为准，
# 运行 `make ai-check` 会拉取列表并核对。实测该账号可用：deepseek-flash、deepseek-v4-pro
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=120s

# ==================== AI 编排 ====================
# agent loop 的最大工具调用轮数，同时也是校验失败后回灌模型自我修正的次数上限
AI_MAX_TOOL_ROUNDS=6
# 安全阀：单次 ops 超过该条数时不自动应用，转为待用户确认。设为 0 表示关闭
AI_AUTO_APPLY_MAX_OPS=30
# deepseek-flash 是推理模型，思考与正文**共享**这个预算。
# 调得太小会出现「思考把预算吃光、正文为空」，一次 add_items 建 30 项约需 8000。
AI_MAX_TOKENS=8192
AI_TEMPERATURE=0.2
