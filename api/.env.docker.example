# ============================================================
# make docker-run 用的容器环境变量（复制为 api/.env.docker）
#
#   cp api/.env.docker.example api/.env.docker   # 然后填值
#
# ⚠️ 不要整份 cp api/.env 过来。api/.env 是「后端直接跑在宿主机」的配置，
#    其中两个值在容器里是错的，会覆盖镜像内置的正确默认值：
#      APP_ENV=development   -> 镜像会跑成开发模式（gin 调试、数据库连不上也不退出）
#      WEB_DIST_DIR=../web   -> 覆盖成容器内不存在的路径，分享页 SSR 退化为兜底页
#
# 镜像已内置以下值，无需在此重复（重复反而会写成宿主机的错误值）：
#   APP_ENV=production
#   HTTP_PORT=8401
#   WEB_DIST_DIR=/usr/share/nginx/html
#   RUN_MIGRATIONS=true
# ============================================================

# ---------- 必填 ----------
# 数据库。容器里的 localhost 指容器自己，所以：
#   连宿主机上的 PostgreSQL（本机开发）-> 写 host.docker.internal
#   连远程数据库                       -> 直接写远程地址
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/dspecs?sslmode=disable

# JWT 签名密钥。生成方式：openssl rand -base64 48 | tr -d '/+='
# 不填会退化成内置的 change-me-in-production，仅够本地试跑
JWT_SECRET=

# ---------- 可选 ----------
# 留空则应用正常启动，但 AI 对话不可用
DEEPSEEK_API_KEY=

# 分享页 SEO：canonical / OG / sitemap 的绝对地址
SITE_URL=http://localhost:8400
SITE_NAME=参数配置表

# 本地试跑时建议关掉，避免对目标库执行迁移（尤其当 DATABASE_URL 指向远程库）
# RUN_MIGRATIONS=false
